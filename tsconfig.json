{
  // This file is not used in compilation. It is here just for a nice editor
  // experience, and to type-check the JS config files via `npm run typecheck`.
  "extends": "@tsconfig/docusaurus/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["docusaurus.config.js", "sidebars.js", "src/**/*"]
}
