{
  // This file is not used in compilation. It is here just for a nice editor
  // experience, and to type-check the JS config files via `npm run typecheck`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node", "@docusaurus/module-type-aliases"]
  },
  "include": ["docusaurus.config.js", "sidebars.js", "src/**/*"]
}
